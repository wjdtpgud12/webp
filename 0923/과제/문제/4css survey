/* survey4.css */
body {
    background-color: aliceblue; /* 메인 페이지와 동일한 배경색 */
}

h1 {
    color: brown;
    text-align: center;
}

p {
    font-family: "휴먼편지체", "맑은 고딕", sans-serif;
    font-size: 1em;
}

/* 폼 영역 디자인 꾸미기 (교재 이미지 참조) */
form {
    background-color: #d8a8a8; /* 팥죽색/핑크색 배경 */
    border: 1px solid #a07070;
    padding: 15px;
    margin: 15px 0;
}

/* 남기고 싶은 말 텍스트 박스 꾸미기 */
textarea {
    border: 1px solid #c85a5a;
}

/* 푸터 디자인 (메인 페이지와 동일) */
footer {
    background-color: orange;
    border-radius: 10px;
    padding: 5px 15px;
}
