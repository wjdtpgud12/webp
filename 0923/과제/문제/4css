/* 4.css */
body {
    background-color: aliceblue;
}

h1 {
    color: brown;
    text-align: center;
}

header {
    border-bottom: 1px solid gray; /* 1픽셀 직선 테두리 */
    padding-bottom: 10px;
}

ul {
    border: 1px dotted gray; /* 1픽셀 점선 테두리 */
    padding: 15px; /* 내용이 테두리에 붙지 않도록 여백 추가 */
    margin: 10px 0;
}

a {
    text-decoration: none; /* 링크 밑줄 없앰 */
}

p {
    font-family: "휴먼편지체", "맑은 고딕", sans-serif;
    font-size: 1em;
    text-indent: 1em; /* 들여쓰기 */
}

h2 {
    color: blue;
    text-shadow: 2px 2px 3px lightgray; /* 텍스트 그림자 꾸밈 */
}

footer {
    background-color: orange;
    border-radius: 10px; /* 둥근 모서리 테두리 */
    padding: 10px; /* 보기 좋게 안쪽 여백 추가 */
    margin-top: 20px;
}
